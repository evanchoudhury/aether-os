{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 4,
  "modules-left": ["custom/aether", "custom/labmode"],
  "modules-center": [],
  "modules-right": ["cpu", "memory", "network", "pulseaudio", "custom/nightlight", "custom/notifications", "clock"],

  "custom/aether": {
    "format": "AETHER",
    "tooltip": false
  },
  "custom/notifications": {
    "format": "Alerts",
    "on-click": "aether-noticenter",
    "tooltip": false
  },
  "custom/nightlight": {
    "format": "Night {}",
    "exec": "aether-nightlight status",
    "interval": 10,
    "on-click": "aether-nightlight toggle",
    "tooltip": false
  },
  "custom/labmode": {
    "exec": "/usr/bin/aether-labmode-waybar",
    "return-type": "json",
    "interval": 2,
    "tooltip": true
  },
  "clock": {
    "format": "{:%a %d %b  %H:%M}"
  },
  "cpu": {
    "format": "CPU {usage}%",
    "interval": 5
  },
  "memory": {
    "format": "RAM {percentage}%",
    "interval": 5
  },
  "network": {
    "format-wifi": "{essid} {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline"
  },
  "pulseaudio": {
    "format": "{volume}%",
    "format-muted": "muted"
  }
}
