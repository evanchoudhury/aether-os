#!/usr/bin/env python3
# AETHER Lab Mode panel. GTK4/libadwaita control for arming/disarming Lab Mode.
# It calls the unprivileged `aether-labmode` CLI, which routes privileged work
# through pkexec. The toggle commits to ARMED only when `arm` exits 0 — a failed
# arm reverts to SAFE and shows an error, so the UI never lies about the
# firewall. [STATUS: UNTESTED]
#
# Run `aether-labmode-panel --selftest` to check the safety invariant without a
# display (no GTK needed).
import sys


def resolve_state(action: str, prev_state: str, exit_code: int) -> str:
    """The one safety-critical rule: a non-zero exit never changes state.

    So a failed `arm` can never yield 'armed', and a failed `disarm` never
    yields 'safe'. Success moves to the target state.
    """
    if exit_code == 0:
        return "armed" if action == "arm" else "safe"
    return prev_state


def _selftest() -> int:
    assert resolve_state("arm", "safe", 0) == "armed"
    assert resolve_state("arm", "safe", 1) == "safe"       # arm failed -> stay safe
    assert resolve_state("disarm", "armed", 0) == "safe"
    assert resolve_state("disarm", "armed", 1) == "armed"  # disarm failed -> stay armed
    print("selftest OK")
    return 0


CSS = b"""
window { background: #0E1116; color: #E6EAF0; font-family: "Inter"; }
.aether-title { font-size: 20px; font-weight: bold; }
.card { background: #171B22; border: 1px solid #2A313C; border-radius: 10px; }
.badge-safe  { color: #9AA4B2; font-weight: bold; letter-spacing: 1px; }
.badge-armed { color: #D29922; font-weight: bold; letter-spacing: 1px; }
.muted { color: #9AA4B2; }
.scope-banner {
  background: #241E10; color: #E8C98A;
  border: 1px solid #D29922; border-radius: 8px;
  padding: 8px 12px; font-weight: bold;
}
.error { color: #F85149; }
"""


def main() -> int:
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Adw", "1")
    from gi.repository import Gtk, Adw, Gio, Gdk

    class Panel(Adw.ApplicationWindow):
        def __init__(self, app):
            super().__init__(application=app, title="Lab Mode")
            self.set_default_size(380, 300)
            self.state = "safe"
            self.busy = False

            # Honor the system "reduce animations" setting (reduced motion).
            animate = Gtk.Settings.get_default().get_property("gtk-enable-animations")
            self.anim_ms = 280 if animate else 0

            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=16)
            box.set_margin_top(20); box.set_margin_bottom(20)
            box.set_margin_start(20); box.set_margin_end(20)
            self.set_content(box)

            title = Gtk.Label(label="Lab Mode", xalign=0)
            title.add_css_class("aether-title")
            box.append(title)

            # State + toggle row.
            row = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=12)
            row.add_css_class("card")
            row.set_margin_top(4)
            for m in ("set_margin_top", "set_margin_bottom", "set_margin_start", "set_margin_end"):
                getattr(row, m)(14)
            self.badge = Gtk.Label(label="SAFE")
            self.badge.add_css_class("badge-safe")
            self.badge.set_hexpand(True); self.badge.set_xalign(0)
            row.append(self.badge)
            self.switch = Gtk.Switch()
            self.switch.set_valign(Gtk.Align.CENTER)
            self.switch.connect("state-set", self.on_toggle)
            row.append(self.switch)
            box.append(row)

            self.fw = Gtk.Label(label="Firewall: everyday profile", xalign=0)
            self.fw.add_css_class("muted")
            box.append(self.fw)

            # Scope banner that slides down when armed.
            self.revealer = Gtk.Revealer()
            self.revealer.set_transition_type(Gtk.RevealerTransitionType.SLIDE_DOWN)
            self.revealer.set_transition_duration(self.anim_ms)
            banner = Gtk.Label(label="SECURITY RESEARCH  ·  scope: (not set)")
            banner.add_css_class("scope-banner")
            banner.set_xalign(0)
            self.revealer.set_child(banner)
            box.append(self.revealer)

            self.err = Gtk.Label(label="", xalign=0)
            self.err.add_css_class("error")
            box.append(self.err)

            self._sync_from_system()

        def _sync_from_system(self):
            # Reflect actual current state at launch (status is unprivileged).
            try:
                out = Gio.Subprocess.new(
                    ["aether-labmode", "status"],
                    Gio.SubprocessFlags.STDOUT_PIPE,
                ).communicate_utf8(None, None)[1].strip()
            except Exception:
                out = "safe"
            self._set_state("armed" if out == "armed" else "safe")

        def _set_state(self, state):
            self.state = state
            armed = state == "armed"
            self.badge.set_label("ARMED" if armed else "SAFE")
            self.badge.remove_css_class("badge-armed" if not armed else "badge-safe")
            self.badge.add_css_class("badge-armed" if armed else "badge-safe")
            self.fw.set_label(
                "Firewall: research profile" if armed else "Firewall: everyday profile")
            self.revealer.set_reveal_child(armed)
            self.switch.set_active(armed)

        def on_toggle(self, _switch, want_on):
            # Block the default auto-toggle; commit only on a successful apply.
            if self.busy:
                return True
            action = "arm" if want_on else "disarm"
            if (action == "arm") == (self.state == "armed"):
                return False  # already in target state
            self._apply(action)
            return True  # we drive the switch ourselves

        def _apply(self, action):
            self.busy = True
            self.err.set_label("")
            self.switch.set_sensitive(False)
            self.fw.set_label("Applying…")
            proc = Gio.Subprocess.new(
                ["aether-labmode", action], Gio.SubprocessFlags.NONE)
            proc.wait_async(None, self._on_done, action)

        def _on_done(self, proc, result, action):
            self.busy = False
            self.switch.set_sensitive(True)
            try:
                proc.wait_finish(result)
                code = proc.get_exit_status()
            except Exception:
                code = 1
            new_state = resolve_state(action, self.state, code)
            self._set_state(new_state)
            if code != 0:
                self.err.set_label(
                    "Couldn't %s — firewall unchanged." % action)

    class App(Adw.Application):
        def __init__(self):
            super().__init__(application_id="com.aether.labmode.Panel")

        def do_activate(self):
            prov = Gtk.CssProvider()
            prov.load_from_data(CSS)
            Gtk.StyleContext.add_provider_for_display(
                Gdk.Display.get_default(), prov,
                Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
            Panel(self).present()

    return App().run(None)


if __name__ == "__main__":
    if "--selftest" in sys.argv:
        sys.exit(_selftest())
    sys.exit(main())
