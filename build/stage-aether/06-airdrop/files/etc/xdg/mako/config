# AETHER notifications — macOS-style: top-right, rounded, translucent dark, teal accent.
sort=-time
layer=overlay
anchor=top-right
margin=16
padding=14,18
width=380
height=130
border-size=1
border-radius=16
background-color=#171B22E6
text-color=#E6EAF0
border-color=#2A313C
progress-color=over #35D0BA
default-timeout=6000
font=Inter 12
icons=1
max-icon-size=48
outer-margin=10
# Keep expired notifications so the Notification Center (aether-noticenter) can show them.
history=1
max-history=100

[urgency=high]
border-color=#D29922
default-timeout=0

[app-name="LocalSend"]
border-color=#35D0BA
default-timeout=0
