<?xml version="1.0" encoding="UTF-8"?>
<!-- AETHER labwc root menu (right-click the desktop). Dependency-free tool
     discoverability until a proper dock lands. -->
<openbox_menu>
  <menu id="root-menu" label="AETHER">
    <item label="Terminal">
      <action name="Execute"><command>foot</command></action>
    </item>
    <item label="Files">
      <action name="Execute"><command>pcmanfm</command></action>
    </item>
    <item label="AirDrop (LocalSend)">
      <action name="Execute"><command>localsend_app</command></action>
    </item>
    <item label="App Launcher">
      <action name="Execute"><command>fuzzel</command></action>
    </item>
    <item label="Lab Mode">
      <action name="Execute"><command>aether-labmode-panel</command></action>
    </item>
    <item label="Anonymous Browser (Tor)">
      <action name="Execute"><command>aether-anon-browser</command></action>
    </item>
    <item label="Capture Finding">
      <action name="Execute"><command>aether-capture</command></action>
    </item>
    <separator/>
    <menu id="aether-apps-menu" label="Applications">
      <item label="Text Editor">
        <action name="Execute"><command>gnome-text-editor</command></action>
      </item>
      <item label="Calculator">
        <action name="Execute"><command>gnome-calculator</command></action>
      </item>
      <item label="Media Player (mpv)">
        <action name="Execute"><command>mpv</command></action>
      </item>
      <item label="PDF Viewer">
        <action name="Execute"><command>evince</command></action>
      </item>
      <item label="Archive Manager">
        <action name="Execute"><command>file-roller</command></action>
      </item>
      <item label="Screen Recorder">
        <action name="Execute"><command>sh -c "wf-recorder -f $HOME/recording-$(date +%s).mp4"</command></action>
      </item>
    </menu>
    <menu id="aether-system-menu" label="System">
      <item label="Disk Usage">
        <action name="Execute"><command>baobab</command></action>
      </item>
      <item label="Audio Settings">
        <action name="Execute"><command>pavucontrol</command></action>
      </item>
      <item label="Network Settings">
        <action name="Execute"><command>nm-connection-editor</command></action>
      </item>
      <item label="Backup (Timeshift)">
        <action name="Execute"><command>timeshift-gtk</command></action>
      </item>
      <item label="Pi Config (terminal)">
        <action name="Execute"><command>foot -e sudo raspi-config</command></action>
      </item>
    </menu>
    <separator/>
    <menu id="aether-tools-menu" label="Security Tools">
      <item label="nmap (network scan)">
        <action name="Execute"><command>aether-tool nmap</command></action>
      </item>
      <item label="tcpdump (packet dump)">
        <action name="Execute"><command>aether-tool tcpdump</command></action>
      </item>
      <item label="Wireshark (packet analysis)">
        <action name="Execute"><command>wireshark</command></action>
      </item>
      <item label="aircrack-ng (wireless)">
        <action name="Execute"><command>aether-tool aircrack-ng</command></action>
      </item>
      <item label="John the Ripper (passwords)">
        <action name="Execute"><command>aether-tool john</command></action>
      </item>
      <item label="hydra (login brute)">
        <action name="Execute"><command>aether-tool hydra</command></action>
      </item>
      <item label="nikto (web scan)">
        <action name="Execute"><command>aether-tool nikto</command></action>
      </item>
      <item label="sqlmap (sqli)">
        <action name="Execute"><command>aether-tool sqlmap</command></action>
      </item>
    </menu>
    <separator/>
    <item label="Reconfigure">
      <action name="Reconfigure"/>
    </item>
    <item label="Exit">
      <action name="Exit"/>
    </item>
  </menu>
</openbox_menu>
