#!/usr/bin/env python3
# AETHER Report — compile the findings you captured (Print key -> aether-capture)
# into one clean, printable, self-contained HTML report you can share or submit.
# Screenshots are embedded, so the file stands alone. Opens when done.
#   aether-report            build + open the report
#   aether-report --no-open  build only, print the path
import os, re, sys, base64, html, socket, subprocess, datetime, mimetypes

FIND = os.path.expanduser("~/AETHER/findings")
LOG = os.path.join(FIND, "findings.md")
OUTDIR = os.path.expanduser("~/AETHER/reports")

def scope():
    try:
        r = subprocess.run(["aether-scope", "list"], capture_output=True, text=True, timeout=5)
        items = [l.strip() for l in r.stdout.splitlines() if l.strip()]
        return ", ".join(i.replace("(default)", "").strip() for i in items) or "not set"
    except Exception:
        return "not set"

def data_uri(path):
    try:
        mime = mimetypes.guess_type(path)[0] or "image/png"
        return "data:%s;base64,%s" % (mime, base64.b64encode(open(path, "rb").read()).decode())
    except Exception:
        return ""

def parse():
    # Split the findings log into (timestamp, image-path, note) tuples.
    try:
        text = open(LOG).read()
    except Exception:
        return []
    out = []
    for block in re.split(r"(?m)^## ", text)[1:]:
        lines = block.splitlines()
        ts = lines[0].strip() if lines else ""
        m = re.search(r"!\[finding\]\(([^)]+)\)", block)
        img = os.path.join(FIND, m.group(1)) if m else ""
        note = ""
        nm = re.search(r"(?m)^- note:\s*(.*)$", block)
        if nm:
            note = nm.group(1).strip()
        out.append((ts, img, note or "(no note recorded)"))
    return out

CSS = """
*{box-sizing:border-box} body{font-family:Inter,system-ui,Arial,sans-serif;color:#1b2330;
  background:#eef1f5;margin:0;padding:32px}
.page{max-width:820px;margin:0 auto;background:#fff;border-radius:14px;overflow:hidden;
  box-shadow:0 10px 40px rgba(20,30,50,.12)}
.hd{background:#0E1116;color:#E6EAF0;padding:28px 34px}
.hd h1{margin:0 0 4px;font-size:24px;letter-spacing:.3px}
.hd .sub{color:#9AA4B2;font-size:13px}
.accent{color:#35D0BA}
.meta{display:flex;flex-wrap:wrap;gap:8px 28px;padding:18px 34px;border-bottom:1px solid #e4e8ee;font-size:13px}
.meta b{color:#5a6577;font-weight:600}
.body{padding:10px 34px 34px}
.f{border:1px solid #e4e8ee;border-radius:12px;padding:18px;margin-top:20px}
.f h3{margin:0 0 2px;font-size:15px}
.f .ts{color:#8a94a4;font-size:12px;font-family:ui-monospace,monospace}
.f .note{margin:10px 0 12px;font-size:14px;white-space:pre-wrap}
.f img{max-width:100%;border-radius:8px;border:1px solid #e4e8ee}
.empty{padding:40px;text-align:center;color:#8a94a4}
.ft{padding:18px 34px;border-top:1px solid #e4e8ee;color:#8a94a4;font-size:12px}
@media print{body{background:#fff;padding:0}.page{box-shadow:none}}
"""

def build():
    findings = parse()
    now = datetime.datetime.now().strftime("%Y-%m-%d %H:%M")
    host = html.escape(socket.gethostname())
    rows = []
    for i, (ts, img, note) in enumerate(findings, 1):
        uri = data_uri(img) if img else ""
        imgtag = '<img src="%s" alt="finding">' % uri if uri else '<p class="note">[screenshot missing]</p>'
        rows.append(
            '<div class="f"><h3>Finding %d</h3><div class="ts">%s</div>'
            '<div class="note">%s</div>%s</div>'
            % (i, html.escape(ts), html.escape(note), imgtag))
    body = "\n".join(rows) if rows else (
        '<div class="empty">No findings captured yet.<br>Press <b>Print</b> during a test to capture one.</div>')
    doc = """<!doctype html><html><head><meta charset=utf-8>
<title>AETHER Findings Report</title><style>%s</style></head><body><div class=page>
<div class=hd><h1>AETHER <span class=accent>Security Findings</span></h1>
<div class=sub>Generated by AETHER OS</div></div>
<div class=meta><span><b>Generated</b> %s</span><span><b>Host</b> %s</span>
<span><b>Findings</b> %d</span><span><b>Engagement scope</b> %s</span></div>
<div class=body>%s</div>
<div class=ft>For authorized testing only. Keep this report with the engagement's rules of engagement.</div>
</div></body></html>""" % (CSS, now, host, len(findings), html.escape(scope()), body)

    os.makedirs(OUTDIR, exist_ok=True)
    out = os.path.join(OUTDIR, "aether-report-%s.html" % datetime.datetime.now().strftime("%Y%m%d-%H%M%S"))
    open(out, "w").write(doc)
    return out, len(findings)

if __name__ == "__main__":
    path, n = build()
    print("report: %s  (%d finding%s)" % (path, n, "" if n == 1 else "s"))
    if "--no-open" not in sys.argv:
        try: subprocess.Popen(["xdg-open", path])
        except Exception: pass
