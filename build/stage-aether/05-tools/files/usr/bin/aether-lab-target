#!/usr/bin/env python3
# AETHER Practice Target — an INTENTIONALLY VULNERABLE web app for learning.
#
# SAFETY (do not change): it binds to 127.0.0.1 ONLY (never the network), holds
# nothing but fake seeded data, and is off until you start it from Guided Labs.
# It is genuinely vulnerable (real SQL injection, weak login) so the real tools
# work against a legal target you own. Never expose it; never put real data in it.
#
# Stdlib only (http.server + sqlite3) — no dependencies, no bloat. Ctrl-C to stop.
import sqlite3, html, os, sys
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import urlparse, parse_qs, unquote_plus

HOST, PORT = "127.0.0.1", 8080  # localhost only — do not make this configurable.
DB = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "aether-lab.sqlite")

def seed():
    if os.path.exists(DB): os.remove(DB)
    c = sqlite3.connect(DB)
    c.executescript("""
      CREATE TABLE users(id INTEGER PRIMARY KEY, username TEXT, password TEXT, secret TEXT);
      CREATE TABLE items(id INTEGER PRIMARY KEY, name TEXT, description TEXT);
      INSERT INTO users VALUES
        (1,'admin','admin123','FLAG{weak_password_pwned}'),
        (2,'guest','guest','just a guest account'),
        (3,'root','toor','FLAG{default_creds_are_bad}');
      INSERT INTO items VALUES
        (1,'Widget','A perfectly ordinary widget.'),
        (2,'Gadget','Slightly fancier than a widget.'),
        (3,'Doohickey','Nobody is sure what it does.');
    """)
    c.commit(); c.close()

PAGE = """<!doctype html><meta charset=utf-8><title>AETHER Practice Target</title>
<style>body{{font-family:system-ui,sans-serif;background:#0E1116;color:#E6EAF0;max-width:720px;margin:40px auto;padding:0 20px}}
a{{color:#35D0BA}} .warn{{color:#D29922;border:1px solid #D29922;border-radius:10px;padding:10px 14px}}
code{{background:#000;color:#35D0BA;padding:2px 6px;border-radius:6px}}</style>
<h1>AETHER Practice Target</h1>
<p class=warn>Intentionally vulnerable. Localhost only, fake data. For learning the AETHER tools against a target you own.</p>
{body}"""

def send(h, body, code=200, ctype="text/html"):
    b = body.encode()
    h.send_response(code); h.send_header("Content-Type", ctype)
    h.send_header("Content-Length", str(len(b)))
    h.send_header("Server", "AetherPractice/1.0"); h.end_headers()
    h.wfile.write(b)

class Lab(BaseHTTPRequestHandler):
    def log_message(self, *a): pass  # quiet

    def do_GET(self):
        u = urlparse(self.path); q = parse_qs(u.query)
        if u.path == "/":
            send(self, PAGE.format(body=(
                "<p>Endpoints: <a href=/login>/login</a> · "
                "<a href='/item?id=1'>/item?id=1</a> · <a href=/robots.txt>/robots.txt</a></p>")))
        elif u.path == "/login":
            send(self, PAGE.format(body=(
                "<h2>Login</h2><form method=post action=/login>"
                "<p>User: <input name=user></p><p>Pass: <input name=pass type=password></p>"
                "<button>Sign in</button></form>")))
        elif u.path == "/item":
            # VULNERABLE ON PURPOSE: raw string-concat into the query → real SQLi.
            raw = (q.get("id", ["1"])[0])
            conn = sqlite3.connect(DB)
            try:
                rows = conn.execute(
                    "SELECT id,name,description FROM items WHERE id=" + raw).fetchall()
                body = "<h2>Item lookup</h2><ul>" + "".join(
                    "<li>%s — %s: %s</li>" % (r[0], html.escape(str(r[1])), html.escape(str(r[2])))
                    for r in rows) + "</ul>"
            except Exception as e:
                body = "<h2>Item lookup</h2><p class=warn>SQL error: %s</p>" % html.escape(str(e))
            finally:
                conn.close()
            send(self, PAGE.format(body=body))
        elif u.path == "/robots.txt":
            send(self, "User-agent: *\nDisallow: /admin\n", ctype="text/plain")
        elif u.path == "/admin":
            send(self, PAGE.format(body="<h2>Admin</h2><p>403 — but you found the hidden path.</p>"), 403)
        else:
            send(self, PAGE.format(body="<p>404 Not Found</p>"), 404)

    def do_POST(self):
        n = int(self.headers.get("Content-Length", 0))
        data = parse_qs(self.rfile.read(n).decode())
        user = data.get("user", [""])[0]; pw = data.get("pass", [""])[0]
        conn = sqlite3.connect(DB)
        row = conn.execute("SELECT secret FROM users WHERE username=? AND password=?",
                           (user, pw)).fetchone()
        conn.close()
        if row:
            send(self, PAGE.format(body="<h2>Welcome, %s</h2><p>Secret: <code>%s</code></p>"
                                   % (html.escape(user), html.escape(row[0]))))
        else:
            send(self, PAGE.format(body="<h2>Login</h2><p class=warn>Invalid credentials</p>"), 401)

if __name__ == "__main__":
    seed()
    srv = HTTPServer((HOST, PORT), Lab)
    print("AETHER Practice Target on http://%s:%d — intentionally vulnerable, localhost only. Ctrl-C to stop." % (HOST, PORT), flush=True)
    try: srv.serve_forever()
    except KeyboardInterrupt: pass
